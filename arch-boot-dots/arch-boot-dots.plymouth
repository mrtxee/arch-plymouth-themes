[Plymouth Theme]
Name=Arch Boot Dots
Description=Arch boot splash with glowing dots
Comment=Created by Mr Txee (mrtxee), GPL-2.0-only
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/arch-boot-dots
ScriptFile=/usr/share/plymouth/themes/arch-boot-dots/arch-boot-dots.script